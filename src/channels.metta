;configured at runtime:
(= (IRC_channel) (empty))
(= (IRC_server) (empty))
(= (IRC_port) (empty))
(= (IRC_user) (empty))
(= (commchannel) (empty))
(= (MM_URL) (empty))
(= (MM_CHANNEL_ID) (empty))
(= (MM_BOT_TOKEN) (empty))
(= (TG_BOT_TOKEN) (empty))
(= (TG_CHAT_ID) (empty))
(= (DISCORD_BOT_TOKEN) (empty))
(= (DISCORD_CHANNEL_ID) (empty))
(= (SLACK_BOT_TOKEN) (empty))
(= (SLACK_CHANNEL_ID) (empty))

;Connect all the channels:
(= (initChannels)
   (progn (println! "Initializing channels")
          (configure commchannel irc)
          (if (== (commchannel) irc)
              (progn (configure IRC_channel #purpleclaw)
                     (configure IRC_server "irc.quakenet.org")
                     (configure IRC_port 6667)
                     (configure IRC_user purpleclaw)
                     (py-call (irc.start_irc (IRC_channel) (IRC_server) (IRC_port) (IRC_user))))
              (if (== (commchannel) mattermost)
                  (progn (configure MM_URL "https://chat.singularitynet.io")
                         (configure MM_CHANNEL_ID "8fjrmabjx7gupy7e5kjznpt5qh")
                         (configure MM_BOT_TOKEN "")
                         (py-call (mattermost.start_mattermost (MM_URL) (MM_CHANNEL_ID) (MM_BOT_TOKEN))))
                  (if (== (commchannel) telegram)
                      (progn (configure TG_BOT_TOKEN "")
                             (configure TG_CHAT_ID "")
                             (py-call (telegram.start_telegram (TG_BOT_TOKEN) (TG_CHAT_ID))))
                      (if (== (commchannel) discord)
                          (progn (configure DISCORD_BOT_TOKEN "")
                                 (configure DISCORD_CHANNEL_ID "")
                                 (py-call (discord.start_discord (DISCORD_BOT_TOKEN) (DISCORD_CHANNEL_ID))))
                          (if (== (commchannel) slack)
                              (progn (configure SLACK_BOT_TOKEN "")
                                     (configure SLACK_CHANNEL_ID "")
                                     (py-call (slack.start_slack (SLACK_BOT_TOKEN) (SLACK_CHANNEL_ID))))
                              (progn (configure IRC_channel #purpleclaw)
                                     (configure IRC_server "irc.quakenet.org")
                                     (configure IRC_port 6667)
                                     (configure IRC_user purpleclaw)
                                     (configure commchannel irc)
                                     (py-call (irc.start_irc (IRC_channel) (IRC_server) (IRC_port) (IRC_user))))))))))))

;Receive the latest user message considering all communication channels:
(= (receive)
   (if (== (commchannel) irc)
       (py-call (irc.getLastMessage))
       (if (== (commchannel) mattermost)
           (py-call (mattermost.getLastMessage))
           (if (== (commchannel) telegram)
               (py-call (telegram.getLastMessage))
               (if (== (commchannel) discord)
                   (py-call (discord.getLastMessage))
                   (if (== (commchannel) slack)
                       (py-call (slack.getLastMessage))
                       ""))))))

;Send a message to all communication channels:
(= (send $msg)
   (let $safemsg (string-replace $msg  "\n" "\\n")
        (if (== (commchannel) irc)
            (let $temp (cut) (py-call (irc.send_message $safemsg)))
            (if (== (commchannel) mattermost)
                (let $temp (cut) (py-call (mattermost.send_message $safemsg)))
                (if (== (commchannel) telegram)
                    (let $temp (cut) (py-call (telegram.send_message $safemsg)))
                    (if (== (commchannel) discord)
                        (let $temp (cut) (py-call (discord.send_message $safemsg)))
                        (if (== (commchannel) slack)
                            (let $temp (cut) (py-call (slack.send_message $safemsg)))
                            False)))))))

;Search the internet for some information:
(= (search $msg)
   (py-call (websearch.search $msg)))

;Join an IRC channel and switch active outbound target channel.
(= (join-channel $channel)
   (if (== (commchannel) irc)
       (py-call (irc.join_channel $channel))
       False))

;Alias forms:
(= (join $channel)
   (join-channel $channel))

(= (join channel $channel)
   (join-channel $channel))

;Leave an IRC channel and keep current outbound target aligned.
(= (leave-channel $channel)
   (if (== (commchannel) irc)
       (py-call (irc.leave_channel $channel))
       False))

;Alias forms:
(= (leave $channel)
   (leave-channel $channel))

(= (leave channel $channel)
   (leave-channel $channel))
