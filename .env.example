# -----------------------------
# Core runtime
# -----------------------------
OPENAI_API_KEY=ollama-local
METTACLAW_UID=1000
METTACLAW_GID=1000
METTACLAW_COMMCHANNEL=irc

# -----------------------------
# Ollama
# -----------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-coder-next:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_AUTO_PULL=true
OLLAMA_KEEP_ALIVE=-1
OLLAMA_CHAT_STREAM=false
OLLAMA_PREWARM=true
OLLAMA_PREWARM_PROMPT=respond with: ready
OLLAMA_PREWARM_THINK=false
OLLAMA_THINK=false
OLLAMA_TIMEOUT_S=180
OLLAMA_CONNECT_TIMEOUT_S=5
OLLAMA_READ_TIMEOUT_S=180
OLLAMA_NUM_PREDICT_CAP=192
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.7

# -----------------------------
# Direct-answer generation
# -----------------------------
OLLAMA_DIRECT_NUM_PREDICT=12
OLLAMA_DIRECT_PROMPT_PREFIX=One-word answer if possible:
OLLAMA_DETAIL_NUM_PREDICT=24
OLLAMA_DETAIL_PROMPT_PREFIX=Answer briefly with practical details:
OLLAMA_CREATIVE_NUM_PREDICT=64
OLLAMA_CREATIVE_PROMPT_PREFIX=Tell a complete short joke/story with a clear ending:
OLLAMA_LONG_FORM_NUM_PREDICT=128
OLLAMA_LONG_FORM_PROMPT_PREFIX=Provide a complete, practical answer with clear structure and concrete details:
OLLAMA_LONG_FORM_CREATIVE_NUM_PREDICT=220
OLLAMA_LONG_FORM_CREATIVE_PROMPT_PREFIX=Tell a full, complete joke/story with setup and payoff. End cleanly:
OLLAMA_DIRECT_MAX_USER_CHARS=120
OLLAMA_DIRECT_MAX_USER_WORDS=16
OLLAMA_DIRECT_MAX_REPLIES=3

# -----------------------------
# MeTTaClaw behavior
# -----------------------------
METTACLAW_LLM_MODE=fast
METTACLAW_WORKER_POOL_SIZE=3
METTACLAW_MAX_SEND_CHARS=280
METTACLAW_DETAIL_MAX_SEND_CHARS=700
METTACLAW_CREATIVE_MAX_SEND_CHARS=700
METTACLAW_LONG_FORM_MAX_SEND_CHARS=1800
METTACLAW_ASYNC_DISPATCH=true
METTACLAW_ASYNC_DISPATCH_WORKERS=4
METTACLAW_ASYNC_DISPATCH_MAX_BATCH=8
METTACLAW_AUTH_REQUIRED=true
METTACLAW_AUTH_SECRET=
METTACLAW_AUTH_SECRET_BYTES=12
METTACLAW_AUTH_HINT_COOLDOWN_S=45

# -----------------------------
# IRC
# -----------------------------
IRC_CHANNEL=#purpleclaw
IRC_SERVER=irc.quakenet.org
IRC_PORT=6667
IRC_USER=purpleclaw
IRC_RANDOM_SUFFIX=true
IRC_LOG_OUTBOUND=true
IRC_MAX_MSG_LEN=360
IRC_CHUNK_DELAY_MS=80
IRC_RECEIVE_BATCH_SIZE=3
IRC_RECEIVE_COALESCE_MS=250

# -----------------------------
# Mattermost
# -----------------------------
MM_URL=https://chat.singularitynet.io
MM_CHANNEL_ID=
MM_BOT_TOKEN=

# -----------------------------
# Telegram
# -----------------------------
TG_BOT_TOKEN=
TG_CHAT_ID=

# -----------------------------
# Discord
# -----------------------------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# -----------------------------
# Slack
# -----------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# -----------------------------
# Vibe Voice (WebSocket + React)
# -----------------------------
VIBE_VOICE_HOST=0.0.0.0
VIBE_VOICE_PORT=8012
VIBE_VOICE_DEFAULT_USER=vibe-user
VIBE_VOICE_ENABLED=true
VIBE_VOICE_FRONTEND_PORT=5173

# -----------------------------
# Memory / tracing
# -----------------------------
CHROMA_DB_PATH=/PeTTa/repos/mettaclaw/memory/chroma_db
CHROMA_COLLECTION=memories
TRACE_PERFORMANCE=false
CAPABILITY_STATIC_POLICY_PATH=/PeTTa/repos/mettaclaw/memory/capability_static_policy.json
CAPABILITY_DYNAMIC_POLICY_PATH=/PeTTa/repos/mettaclaw/memory/capability_dynamic_policy.json
