; capability policies
(role-capability "trusted-admin" "*")
(role-capability "trusted-user" "current-model")
(role-capability "trusted-user" "current-persona")
(role-capability "trusted-user" "list-channels")
(role-capability "trusted-user" "list-models")
(role-capability "trusted-user" "list-personas")
(role-capability "trusted-user" "pin")
(role-capability "trusted-user" "query")
(role-capability "trusted-user" "remember")
(role-capability "trusted-user" "search")
(role-capability "trusted-user" "send")
(role-capability "trusted-user" "show-current-channel")
(role-capability "trusted-user" "use-persona")
(role-capability "untrusted/public" "query")
(role-capability "untrusted/public" "send")
(policy-admin "*" "trusted-admin")
